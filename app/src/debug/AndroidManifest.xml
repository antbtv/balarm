<?xml version="1.0" encoding="utf-8"?>
<!-- Только debug-сборка: экран feature flags (FR-FLAG-5). Exported — для запуска через adb. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".debug.FeatureFlagsActivity"
            android:exported="true"
            android:label="@string/debug_flags_title" />

        <!-- Только debug: хелпер сценариев надёжности через `adb shell am broadcast -n …` (M1-T15).
             DUMP есть у shell, но не у сторонних приложений: CLEAR_ALL/CRASH им недоступны. -->
        <receiver
            android:name=".debug.DebugAlarmReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
